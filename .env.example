# ============================================================
# IDS Research Pipeline System — Environment Variables
# Copy this file to .env and fill in values for local dev.
# Docker Compose sets these automatically via its environment: block.
# ============================================================

# --- Execution Mode ---
# Set to "true" to use Celery + Redis async execution.
# Set to "false" (default) for synchronous local execution.
USE_ASYNC=false

# --- Database ---
# Path to SQLite database file.
# Default: storage/experiments.db (relative to project root)
# DB_PATH=storage/experiments.db

# --- Celery (only needed when USE_ASYNC=true) ---
# Redis broker URL
# CELERY_BROKER_URL=redis://localhost:6379/0

# Redis result backend URL
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Number of concurrent Celery workers (1 = one experiment at a time)
# Increase only if you have enough RAM for simultaneous ML runs.
# CELERY_CONCURRENCY=1

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Set to "true" for JSON-formatted logs (recommended in Docker)
# JSON_LOGS=false

# --- Docker (set automatically by docker-compose.yml) ---
# Docker image version tag (captured in experiment metadata for reproducibility)
# DOCKER_IMAGE_VERSION=1.0.0

# --- Storage (optional overrides) ---
# Override default storage paths if needed.
# STORAGE_PATH=/custom/path/to/storage
